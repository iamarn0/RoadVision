# RoadVision
# Copy to .env and adjust. Never commit secrets.
#
# Product version is the root VERSION file, not APP_VERSION below.
# APP_VERSION is kept for compatibility and is ignored at runtime.

APP_NAME=RoadVision
# Ignored at runtime; source of truth is the root VERSION file.
APP_VERSION=0.1.0
APP_ENV=development
LOG_LEVEL=INFO

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000
SECRET_KEY=change-me-in-development
AUTH_DISABLED=false
SESSION_COOKIE_NAME=roadvision_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=lax
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=change-me-bootstrap
BOOTSTRAP_ADMIN_NAME=Administrator
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

# --- Frontend ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_WS_BASE_URL=ws://localhost:8000
# Optional UI fallback only; the console reads version from GET /api/version.
NEXT_PUBLIC_APP_VERSION=0.1.0

# --- Database ---
# Local development: SQLite works without creating a Postgres role.
# DATABASE_URL=sqlite:///./storage/roadvision.db
#
# PostgreSQL (after creating user/db — see scripts/setup_postgres.ps1):
DATABASE_URL=postgresql+psycopg://roadvision:change-me@localhost:5432/roadvision

POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=roadvision
POSTGRES_USER=roadvision
POSTGRES_PASSWORD=change-me

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1
MAX_QUEUE_SIZE=100
MAX_WORKERS=1
STALE_JOB_TIMEOUT_SECONDS=900

# --- Storage ---
STORAGE_BACKEND=local
STORAGE_ROOT=./storage
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=
RETENTION_DAYS=30
MAX_UPLOAD_BYTES=2147483648
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,mkv,webm
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/x-msvideo,video/quicktime,video/x-matroska,video/webm

# --- Device / GPU ---
PROCESSING_DEVICE=auto
CUDA_DEVICE=0
USE_HALF_PRECISION=true
AUTO_FALLBACK_TO_CPU=false
OCR_DEVICE=auto

# --- Models ---
VEHICLE_MODEL_PATH=./models/vehicle_detector.pt
PLATE_MODEL_PATH=./models/plate_detector.pt
VEHICLE_MODEL_VERSION=unconfigured
PLATE_MODEL_VERSION=unconfigured

# --- Inference ---
VEHICLE_CONFIDENCE=0.35
PLATE_CONFIDENCE=0.25
IOU_THRESHOLD=0.45
INFERENCE_IMAGE_SIZE=640
INFERENCE_BATCH_SIZE=1
FRAME_SKIP=0
MAX_PROCESSING_FPS=15
PROCESSING_PROFILE=balanced
PLATE_ROI_IMAGE_SIZE=960
PLATE_CANDIDATE_TOP_N=20
ANPR_DEBUG=false

# Plate crop gates and ranking. A ~182x53 H.264 plate should not be hard-rejected.
PLATE_QUALITY_MIN_WIDTH_PX=28
PLATE_QUALITY_MIN_HEIGHT_PX=10
PLATE_QUALITY_MIN_DETECTOR_CONFIDENCE=0.15
PLATE_QUALITY_MAX_SATURATION_RATIO=0.45
PLATE_QUALITY_MIN_SHARPNESS=12
PLATE_QUALITY_MIN_CONTRAST=8
PLATE_QUALITY_MIN_ASPECT=1.3
PLATE_QUALITY_MAX_ASPECT=7.0
PLATE_QUALITY_WEIGHT_SIZE=0.22
PLATE_QUALITY_WEIGHT_SHARPNESS=0.18
PLATE_QUALITY_WEIGHT_CONTRAST=0.16
PLATE_QUALITY_WEIGHT_EXPOSURE=0.14
PLATE_QUALITY_WEIGHT_SATURATION=0.12
PLATE_QUALITY_WEIGHT_GEOMETRY=0.10
PLATE_QUALITY_WEIGHT_DETECTOR_CONFIDENCE=0.08

# --- OCR ---
OCR_ENGINE=easyocr
OCR_LANGUAGES=en
OCR_INTERVAL_FRAMES=3
HIGH_CONFIDENCE_THRESHOLD=0.85
MEDIUM_CONFIDENCE_THRESHOLD=0.65
LOW_CONFIDENCE_THRESHOLD=0.40
DISPLAY_PLATE_THRESHOLD=0.65

# --- Processing source ---
DEFAULT_SOURCE_TYPE=uploaded_video
