APP_NAME=RoadVision
# Ignored at runtime; source of truth is the root VERSION file.
APP_VERSION=0.1.0
APP_ENV=production
LOG_LEVEL=INFO

API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=https://unikorncam.tech
SECRET_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32
AUTH_DISABLED=false
SESSION_COOKIE_NAME=roadvision_session
SESSION_TTL_SECONDS=604800
SESSION_COOKIE_SECURE=true
SESSION_COOKIE_SAMESITE=lax
BOOTSTRAP_ADMIN_EMAIL=admin@unikornservices.com
BOOTSTRAP_ADMIN_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
BOOTSTRAP_ADMIN_NAME=Administrator
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300

NEXT_PUBLIC_API_BASE_URL=https://unikorncam.tech
NEXT_PUBLIC_WS_BASE_URL=wss://unikorncam.tech
# Optional UI fallback only; the console reads version from GET /api/version.
NEXT_PUBLIC_APP_VERSION=0.1.0

POSTGRES_DB=roadvision
POSTGRES_USER=roadvision
POSTGRES_PASSWORD=REPLACE_WITH_ALPHANUMERIC_PASSWORD
DATABASE_URL=postgresql+psycopg://roadvision:REPLACE_WITH_ALPHANUMERIC_PASSWORD@postgres:5432/roadvision

REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1
MAX_QUEUE_SIZE=100
MAX_WORKERS=1
STALE_JOB_TIMEOUT_SECONDS=900

STORAGE_BACKEND=local
STORAGE_ROOT=/app/storage
RETENTION_DAYS=30
MAX_UPLOAD_BYTES=2147483648
ALLOWED_VIDEO_EXTENSIONS=mp4,avi,mov,mkv,webm
ALLOWED_VIDEO_MIME_TYPES=video/mp4,video/x-msvideo,video/quicktime,video/x-matroska,video/webm

PROCESSING_DEVICE=cpu
CUDA_DEVICE=0
USE_HALF_PRECISION=false
AUTO_FALLBACK_TO_CPU=true
OCR_DEVICE=cpu

VEHICLE_MODEL_PATH=/models/vehicle_detector.pt
PLATE_MODEL_PATH=/models/plate_detector.pt
VEHICLE_MODEL_VERSION=yolo11n
PLATE_MODEL_VERSION=yolov8n-license-plate

VEHICLE_CONFIDENCE=0.35
PLATE_CONFIDENCE=0.25
IOU_THRESHOLD=0.45
INFERENCE_IMAGE_SIZE=640
INFERENCE_BATCH_SIZE=1
FRAME_SKIP=1
MAX_PROCESSING_FPS=10
PROCESSING_PROFILE=performance

OCR_ENGINE=easyocr
OCR_LANGUAGES=en
OCR_INTERVAL_FRAMES=5
HIGH_CONFIDENCE_THRESHOLD=0.85
MEDIUM_CONFIDENCE_THRESHOLD=0.65
LOW_CONFIDENCE_THRESHOLD=0.40
DISPLAY_PLATE_THRESHOLD=0.65

DEFAULT_SOURCE_TYPE=uploaded_video
