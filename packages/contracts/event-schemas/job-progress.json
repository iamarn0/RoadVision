{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "JobProgressEvent",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "job_id",
    "status",
    "progress",
    "current_frame",
    "total_frames",
    "processing_fps",
    "estimated_remaining_seconds",
    "vehicles_detected",
    "plates_detected",
    "device"
  ],
  "properties": {
    "job_id": { "type": "string", "format": "uuid" },
    "status": {
      "type": "string",
      "enum": [
        "queued",
        "uploading",
        "validating",
        "processing",
        "finalizing",
        "completed",
        "failed",
        "cancelled"
      ]
    },
    "progress": { "type": "number", "minimum": 0, "maximum": 100 },
    "current_frame": { "type": "integer", "minimum": 0 },
    "total_frames": { "type": "integer", "minimum": 0 },
    "processing_fps": { "type": ["number", "null"] },
    "estimated_remaining_seconds": { "type": ["number", "null"] },
    "vehicles_detected": { "type": "integer", "minimum": 0 },
    "plates_detected": { "type": "integer", "minimum": 0 },
    "device": { "type": ["string", "null"] },
    "error_code": { "type": ["string", "null"] },
    "error_message": { "type": ["string", "null"] }
  }
}
